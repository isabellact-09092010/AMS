programa {
  funcao inicio() {
    inteiro codigo, valor 
    real qtde, Valor_total
    escreva("DIGITE O CÓDIGO DA PEÇA: ")
    leia(codigo)
    escreva("QUAL É O VALOR DA PEÇA? ")
    leia(valor)
    escreva("QUAL É A QUANTIDADE DE PEÇAS? ")
    leia(qtde)
    Valor_total =(valor+qtde)
    escreva ("A PEÇA DE CÓDIGO: ", codigo)
    escreva("  ")
    escreva ("O VALOR A PAGAR É ", Valor_total)
    
  }
}
