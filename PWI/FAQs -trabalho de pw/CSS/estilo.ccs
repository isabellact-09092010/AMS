/* VARIÁVARIS */
:root {
    --cor-principal:#0077cc;
    --cor-houver: #00bfff;
    --cor-voltar: #ff6600;
    --cor-fundo: #f1f1f1; 
    --cor-texto: #333;
}

/*  REST */
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* GERAL */
header {
    background-color: var(--cor-principal);
    padding: 20px;
    position: sticky;
    top: 0;
    z-index: 1000;
}

/* CONTEÚDO */
main {
    width: 90%;
    max-width: 1000px;
    margin: 40px auto;
}

/* GERAL */
body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    scroll-behavior: smooth;
}

/* MENU */
nav a{
    color: var(--cor-fundo);
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
    transition: 0.3s;
}
nav a:houver {
    color: var(--cor-houver) !important;

}

/* VOLTAR */
.voltar {
    text-decoration: none;
    color: var(--cor-principal);
    font-weight: bold;
    transition: 0.3s ;
}

.voltar:houver {
    color: var(--cor-voltar)
}

/* RODAPÉ */
footer {
    background-color: var(--cor-principal);
    color: var(--cor-fundo);
    text-align: center;
    padding: 20px;
}

.container-menu{
    max-width: 1000px;
    margin: auto;
    display: flex;
    justify-content: space-batween;
    align-items: center;
}

/*card*/
.card{
    background-color: var(--cor-fundo);
    margin-bottom: 40px;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 0 10px var(--cor-texto);
}

.card h2{
    color: var(--cor-principal);
    margin-bottom: 20px;
}

/*FAQ*/
.faq{
    margin-bottom: 25px;
}

.faq h3{
    margin-bottom: 10px;
    color: var(--cor-texto);
}

.faq p{
    color: var(--cor-texto);

}