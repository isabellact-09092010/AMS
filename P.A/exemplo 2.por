  programa {
    funcao inicio() {
      cadeia palavras[] = {"questao", "fundamental"}
      
      escreva("Antes da alteração: ", palavras[0], "\n")
      palavras[0] = "pergunta"

      escreva(" Depois da alteração: ", palavras[0], "\n")
      escreva(" Segunda palavra: ", palavras[1], "\n")
  }
}